{
  "name": "@lemol/ui",
  "version": "0.1.0",
  "private": true,
  "description": "UI for lemol projects: renderer-agnostic design tokens, Remix 3 components, and one minimal reference design",
  "workspaces": [
    "apps/*",
    "proof"
  ],
  "type": "module",
  "exports": {
    "./design": "./src/design/index.ts",
    "./design/css": "./src/design/css/index.ts",
    "./remix": "./src/remix/index.ts",
    "./remix/overlay": "./src/remix/dialog/overlay.tsx",
    "./remix/compat": "./src/remix/compat.ts",
    "./remix/runtime": "./src/remix/runtime.ts",
    "./remix/demos": "./src/remix/demos.ts",
    "./pwa": "./src/pwa/index.ts",
    "./mini": "./src/mini/index.ts",
    "./mini/document": "./src/mini/document.tsx"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "bun fmt --check && oxlint",
    "fix": "oxlint --fix && bun fmt",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "test:git-consumer": "bun test test/git-consumer.test.ts",
    "playground": "bun --filter @lemol/ui-playground dev"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.21",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.4.2",
    "oxlint": "^1.87.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "remix": "3.1.0"
  }
}
