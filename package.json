{
  "name": "@lemol/ui",
  "version": "0.1.0",
  "private": true,
  "description": "UI packages shared by lemol projects: design tokens, Remix 3 components, and a minimal reference design",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "playground": "bun --filter @lemol/ui-playground dev"
  },
  "peerDependencies": {
    "remix": "3.0.0-rc.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
