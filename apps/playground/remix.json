{
  "$schema": "../../node_modules/remix/schema/remix.json",

  // The single source of asset configuration: `app/assets.ts` loads this block
  // and adds only what JSON cannot express (the browser target, watching, and
  // the Bun store mount). `remix assets` and `remix doctor` read the same
  // block, so the running server and the CLI cannot disagree about what is
  // browser-reachable.
  "assets": {
    "basePath": "/assets",

    // Browser-reachable source lives in `public/` directories beside its
    // narrowest owner. Everything else under `app/` stays server-only, so a
    // controller cannot leak into the browser by being imported.
    //
    // `../../src/**` is `@lemol/ui`'s own source, which the browser reaches
    // for the compat shim and the runtime. It is admitted by path and NOT by
    // adding `@lemol/ui` to `allowPackages`: the package is a `file:`
    // dependency pointing at this repository's root, so admitting it by name
    // admits every file under that root — this app's own controllers,
    // document and router included — and `allowFiles` cannot claw that back,
    // because the package check is a fallback that runs only once a file has
    // failed every `allowFiles` pattern. Naming the path keeps the allow-list
    // an allow-list instead of a deny-list chasing it.
    "allowFiles": ["app/routes.ts", "app/**/public/**", "../../src/**"],
    "allowPackages": ["remix"],

    "denyFiles": ["app/**/*.test.*"]
  },

  // `remix db` is absent: the playground has no persistence.
  // `remix test` is absent: the suite runs under `bun test`, per AGENTS.md.
  "doctor": {
    "strict": true
  }
}
